{
  "name": "hearth-pi",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-durable": "1.0.1",
    "@gotgenes/pi-anthropic-auth": "3.4.2",
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "linkedom": "0.18.12",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  }
}
